{
  "manifest_version": 3,
  "name": "78KARD re [FIX] in 3",
  "version": "1.0.0",
  "description": "Empacotado nativamente com o DualInfodose Builder",
  "permissions": [
    "storage",
    "activeTab",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://www.w3.org/*",
    "https://kodux78k.github.io/*",
    "https://infodose.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "78KARD re [FIX] in 3"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}